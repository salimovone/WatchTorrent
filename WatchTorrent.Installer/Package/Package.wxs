<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="WatchTorrent" Manufacturer="WatchTorrent contributors"
           Version="$(var.WatchTorrentVersion)" Scope="perUser"
           UpgradeCode="690D6950-B47E-4525-9FEB-5C1F35BDA810">
    <MajorUpgrade DowngradeErrorMessage="A newer version of WatchTorrent is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="WatchTorrentIcon" SourceFile="$(var.WatchTorrentIconDir)\watchtorrent.ico" />
    <Property Id="ARPPRODUCTICON" Value="WatchTorrentIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/salimovone/WatchTorrent" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="WatchTorrent" />
    </StandardDirectory>
    <SetDirectory Id="INSTALLFOLDER" Value="[LocalAppDataFolder]Programs\WatchTorrent" />
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="WatchTorrentStartMenuShortcut" Guid="*">
        <Shortcut Id="StartMenuShortcut" Name="WatchTorrent" Target="[INSTALLFOLDER]WatchTorrent.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="WatchTorrentIcon" />
        <RegistryValue Root="HKCU" Key="Software\WatchTorrent" Name="Installed"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="WatchTorrent" Title="WatchTorrent">
      <ComponentGroupRef Id="WatchTorrentPublishedFiles" />
      <ComponentRef Id="WatchTorrentStartMenuShortcut" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="WatchTorrentPublishedFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.WatchTorrentPublishDir)\**">
        <Exclude Files="$(var.WatchTorrentPublishDir)\**\*.pdb" />
        <!-- Windows Installer rejects the language IDs in these optional WinUI resource DLLs. -->
        <Exclude Files="$(var.WatchTorrentPublishDir)\gd-gb\*.mui" />
        <Exclude Files="$(var.WatchTorrentPublishDir)\mi-NZ\*.mui" />
        <Exclude Files="$(var.WatchTorrentPublishDir)\ug-CN\*.mui" />
      </Files>
    </ComponentGroup>
  </Fragment>
</Wix>
