<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WatchTorrent.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:loc="clr-namespace:WatchTorrent.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:WatchTorrent.Views"
    Title="WatchTorrent"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent
            Title="{loc:Translate S077}"
            Icon="tab_home.png"
            Route="discover"
            ContentTemplate="{DataTemplate views:DiscoverPage}" />

        <Tab x:Name="VoiceTab" Title="{loc:Translate S211}" Icon="tab_connection.png" Route="connection">
            <ShellContent x:Name="ConnectionTab" Title="{loc:Translate S211}" Route="call">
                <views:VoiceCallPage />
            </ShellContent>
        </Tab>

        <ShellContent
            Title="{loc:Translate S247}"
            Icon="tab_downloads.png"
            Route="downloads"
            ContentTemplate="{DataTemplate views:DownloadsPage}" />

        <ShellContent
            Title="{loc:Translate S163}"
            Icon="tab_settings.png"
            Route="settings"
            ContentTemplate="{DataTemplate views:SettingsPage}" />
    </TabBar>

</Shell>
