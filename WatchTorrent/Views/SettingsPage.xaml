<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:WatchTorrent.ViewModels"
    x:Class="WatchTorrent.Views.SettingsPage"
    Title="Sozlamalar"
    Shell.NavBarIsVisible="false"
    x:DataType="vm:SettingsViewModel">
    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,32" Spacing="24" MaximumWidthRequest="800">
            <Label Text="Sozlamalar" Style="{StaticResource PageTitle}" />
            <VerticalStackLayout Spacing="12">
                <Label Text="Tomosha qilish" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <Label Text="HDR tasvir" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                            <Switch
                                Grid.Column="1"
                                IsToggled="{Binding HdrOutput}"
                                IsVisible="{Binding CanSwitchHdr}"
                                OnColor="{StaticResource Accent}"
                                SemanticProperties.Description="HDR tasvirni yoqish" />
                        </Grid>
                        <Label Text="{Binding HdrDescription}" Style="{StaticResource BodyText}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="12">
                <Label Text="Yuklash" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="16">
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <Label Text="Fonda davom ettirish" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                                <Switch
                                    Grid.Column="1"
                                    IsToggled="{Binding BackgroundDownloads}"
                                    OnColor="{StaticResource Accent}"
                                    SemanticProperties.Description="Fonda yuklash" />
                            </Grid>
                            <Label Text="{Binding BackgroundDownloadsDescription}" Style="{StaticResource BodyText}" />
                        </VerticalStackLayout>
                        <BoxView Style="{StaticResource Rule}" />
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <Label Text="Ekranni ochiq tutish" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                                <Switch
                                    Grid.Column="1"
                                    IsToggled="{Binding KeepScreenOnInDownloads}"
                                    OnColor="{StaticResource Accent}"
                                    SemanticProperties.Description="Yuklamalar sahifasida ekran o'chmasin" />
                            </Grid>
                            <Label
                                Text="Faqat yuklash davom etayotganda va Yuklamalar sahifasi ochiq bo'lganda."
                                Style="{StaticResource BodyText}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="10" IsVisible="{Binding HasBatterySetting}">
                            <BoxView Style="{StaticResource Rule}" />
                            <Label Text="Batareya ruxsati" FontFamily="OpenSansSemibold" />
                            <Label Text="{Binding BatteryStatus}" Style="{StaticResource BodyText}" />
                            <Button
                                Text="Fonda ishlashga ruxsat berish"
                                Style="{StaticResource GhostButton}"
                                HorizontalOptions="Start"
                                IsVisible="{Binding IsBatteryUnrestricted, Converter={StaticResource InvertBool}}"
                                Command="{Binding RequestBatteryExemptionCommand}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="8">
                <Label Text="Saqlash joyi" Style="{StaticResource SectionTitle}" />
                <Label Text="{Binding DownloadDirectory}" Style="{StaticResource Muted}" LineBreakMode="CharacterWrap" />
            </VerticalStackLayout>
            <BoxView Style="{StaticResource Rule}" />
            <Label Text="{Binding AppVersion}" Style="{StaticResource Muted}" SemanticProperties.Hint="Direct ulanish testi">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OpenDirectConnectionTest" />
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
