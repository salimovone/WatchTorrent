<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:WatchTorrent.ViewModels"
    xmlns:models="clr-namespace:WatchTorrent.Models"
    x:Class="WatchTorrent.Views.TorrentDetailPage"
    Title="Batafsil"
    Shell.TabBarIsVisible="false"
    x:DataType="vm:TorrentDetailViewModel">
    <Grid RowDefinitions="*,Auto" MaximumWidthRequest="960">
        <ScrollView>
            <VerticalStackLayout Padding="20,20,20,28" Spacing="20">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border
                        WidthRequest="100"
                        HeightRequest="150"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="{StaticResource Surface2}"
                        VerticalOptions="Start"
                        IsVisible="{Binding HasPoster}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenPosterCommand}" />
                        </Border.GestureRecognizers>
                        <Image Source="{Binding PosterUrl}" Aspect="AspectFill" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Start">
                        <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="20" />
                        <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding DisplayDetail.Tags}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Style="{StaticResource Pill}" Margin="0,0,6,6" FlexLayout.Shrink="0">
                                        <Label Text="{Binding .}" Style="{StaticResource PillText}" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Grid>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Border Style="{StaticResource Card}" Padding="12,10">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Hajmi" Style="{StaticResource Muted}" />
                            <Label Text="{Binding Size}" FontFamily="OpenSansSemibold" FontSize="15" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12,10">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Manbalar" Style="{StaticResource Muted}" />
                            <Label
                                Text="{Binding Seeders, StringFormat='{0:N0}'}"
                                TextColor="{StaticResource Seed}"
                                FontFamily="OpenSansSemibold"
                                FontSize="15" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,10">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Yuklayotgan" Style="{StaticResource Muted}" />
                            <Label
                                Text="{Binding Leechers, StringFormat='{0:N0}'}"
                                TextColor="{StaticResource Leech}"
                                FontFamily="OpenSansSemibold"
                                FontSize="15" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
                <ActivityIndicator HeightRequest="32" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" />
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasError}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource TextMuted}" />
                        <Button Text="Qayta urinish" Command="{Binding RetryCommand}" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </Border>
                <VerticalStackLayout Spacing="16" IsVisible="{Binding IsLoaded}">
                    <Button
                        Text="{Binding TechnicalDetailsText}"
                        Command="{Binding ToggleTechnicalDetailsCommand}"
                        Style="{StaticResource TextButton}"
                        HorizontalOptions="Start" />
                    <Border Style="{StaticResource Card}" IsVisible="{Binding ShowTechnicalDetails}">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="8">
                            <Label Text="Yuklagan" Style="{StaticResource Muted}" />
                            <Label Grid.Column="1" Text="{Binding DisplayDetail.UploadedBy}" FontSize="13" />
                            <Label Grid.Row="1" Text="Qo'shilgan" Style="{StaticResource Muted}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding DisplayDetail.DateUploaded}" FontSize="13" />
                            <Label Grid.Row="2" Text="Tekshirilgan" Style="{StaticResource Muted}" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding DisplayDetail.DateLastChecked}" FontSize="13" />
                            <Label Grid.Row="3" Text="Yuklab olingan" Style="{StaticResource Muted}" />
                            <Label
                                Grid.Row="3"
                                Grid.Column="1"
                                Text="{Binding DisplayDetail.Downloads, StringFormat='{0:N0} marta'}"
                                FontSize="13" />
                            <Label Grid.Row="4" Text="Info hash" Style="{StaticResource Muted}" />
                            <Label
                                Grid.Row="4"
                                Grid.Column="1"
                                Text="{Binding DisplayDetail.InfoHash}"
                                FontSize="12"
                                LineBreakMode="CharacterWrap" />
                        </Grid>
                    </Border>
                    <FlexLayout Wrap="Wrap" IsVisible="{Binding ShowTechnicalDetails}">
                        <Button
                            Text="{Binding CopyMagnetText}"
                            Command="{Binding CopyMagnetCommand}"
                            Style="{StaticResource TextButton}" />
                        <Button Text="Boshqa ilovada ochish" Command="{Binding OpenExternalCommand}" Style="{StaticResource TextButton}" />
                    </FlexLayout>
                    <Button
                        Text="Tavsifni ko'rish"
                        Command="{Binding ShowDescriptionCommand}"
                        Style="{StaticResource GhostButton}"
                        IsVisible="{Binding DisplayDetail.HasDescription, FallbackValue=False}" />
                    <Label Text="{Binding FilesHeader}" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Card}" Padding="14,4">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding VisibleFiles}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Text="{Binding .}" Padding="0,8" FontSize="13" LineBreakMode="CharacterWrap" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                    <Button
                        Text="{Binding ShowAllFilesText}"
                        Command="{Binding ShowAllFilesCommand}"
                        Style="{StaticResource GhostButton}"
                        IsVisible="{Binding CanShowAllFiles}" />
                    <Label
                        Text="{Binding DisplayDetail.CommentsHeader}"
                        Style="{StaticResource SectionTitle}"
                        IsVisible="{Binding DisplayDetail.HasComments, FallbackValue=False}" />
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding DisplayDetail.Comments}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:CommentItem">
                                <Border Style="{StaticResource Card}">
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                                        <Border
                                            Grid.RowSpan="2"
                                            WidthRequest="34"
                                            HeightRequest="34"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 17"
                                            BackgroundColor="{StaticResource AccentSoft}"
                                            VerticalOptions="Start">
                                            <Label
                                                Text="{Binding Initial}"
                                                FontFamily="OpenSansSemibold"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                                        </Border>
                                        <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                            <Label Text="{Binding Username}" FontFamily="OpenSansSemibold" FontSize="13" />
                                            <Label Text="{Binding Posted}" Style="{StaticResource Muted}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Text}" FontSize="13" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <Border
            Grid.Row="1"
            Padding="20,12,20,16"
            StrokeThickness="0"
            BackgroundColor="{StaticResource Surface}"
            IsVisible="{Binding IsLoaded}">
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Text="Tomosha qilish" Command="{Binding WatchCommand}" FontSize="14" />
                    <Button
                        Grid.Column="1"
                        Text="{Binding DownloadButtonText}"
                        Command="{Binding DownloadCommand}"
                        Style="{StaticResource GhostButton}"
                        FontSize="14"
                        IsEnabled="{Binding IsAddingDownload, Converter={StaticResource InvertBool}}" />
                </Grid>
                <Label
                    Text="Tomosha qilish yuklamani ham boshlaydi."
                    Style="{StaticResource Muted}"
                    FontSize="12"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
