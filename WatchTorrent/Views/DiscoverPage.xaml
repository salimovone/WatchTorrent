<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:WatchTorrent.ViewModels"
    x:Class="WatchTorrent.Views.DiscoverPage"
    Title="Kashf etish"
    Shell.NavBarIsVisible="false"
    x:DataType="vm:DiscoverViewModel">
    <Grid RowDefinitions="Auto,*" MaximumWidthRequest="1040">
        <VerticalStackLayout Padding="20,8,20,10" Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="WatchTorrent" FontSize="20" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                <ImageButton
                    Grid.Column="1"
                    Source="tab_search.png"
                    BackgroundColor="Transparent"
                    WidthRequest="44"
                    HeightRequest="44"
                    Padding="10"
                    Clicked="OnSearchClicked"
                    SemanticProperties.Description="Film yoki serial qidirish"
                    ToolTipProperties.Text="Qidirish" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border Stroke="{StaticResource StrokeColor}" StrokeShape="RoundRectangle 6" Padding="10,0">
                    <Grid>
                        <Picker
                            Title="Toifa"
                            ItemsSource="{Binding Categories}"
                            ItemDisplayBinding="{Binding Title, x:DataType=vm:DiscoverCategory}"
                            SelectedItem="{Binding SelectedCategory}"
                            SemanticProperties.Description="Torrentlar toifasi" />
                        <Label
                            Text="⌄"
                            FontSize="18"
                            TextColor="{StaticResource TextMuted}"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            InputTransparent="true"
                            IsVisible="{OnPlatform Android=True, Default=False}" />
                    </Grid>
                </Border>
                <Border
                    Grid.Column="1"
                    WidthRequest="120"
                    IsVisible="{Binding ShowRanges}"
                    Stroke="{StaticResource StrokeColor}"
                    StrokeShape="RoundRectangle 6"
                    Padding="10,0">
                    <Grid>
                        <Picker
                            Title="Davr"
                            ItemsSource="{Binding Ranges}"
                            ItemDisplayBinding="{Binding Title, x:DataType=vm:RangeOption}"
                            SelectedItem="{Binding SelectedRange}"
                            SemanticProperties.Description="Ro'yxat davri" />
                        <Label
                            Text="⌄"
                            FontSize="18"
                            TextColor="{StaticResource TextMuted}"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            InputTransparent="true"
                            IsVisible="{OnPlatform Android=True, Default=False}" />
                    </Grid>
                </Border>
            </Grid>
        </VerticalStackLayout>
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView
                ItemsSource="{Binding Items}"
                ItemTemplate="{StaticResource TorrentRowTemplate}"
                SelectionMode="Single"
                SelectionChanged="OnTorrentSelected" />
        </RefreshView>
        <VerticalStackLayout
            Grid.Row="1"
            Padding="24,24"
            Spacing="12"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="Start"
            HorizontalOptions="Center">
            <ActivityIndicator IsRunning="{Binding IsBusy}" HeightRequest="28" />
            <Label Text="Ro'yxat olinmoqda…" Style="{StaticResource BodyText}" />
        </VerticalStackLayout>
        <ScrollView Grid.Row="1" IsVisible="{Binding HasError}">
            <VerticalStackLayout Padding="24,32" Spacing="12" MaximumWidthRequest="460">
                <Label Text="Ro'yxatni yuklab bo'lmadi" Style="{StaticResource SectionTitle}" />
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource BodyText}" />
                <Button Text="Qayta yuklash" Command="{Binding RefreshCommand}" HorizontalOptions="Start" Margin="0,8,0,0" />
                <BoxView Style="{StaticResource Rule}" Margin="0,12" />
                <Label
                    Text="Saqlangan yuklamalaringizni ochishingiz yoki nom bo'yicha qidirishingiz mumkin."
                    Style="{StaticResource BodyText}" />
                <FlexLayout Wrap="Wrap">
                    <Button Text="Yuklamalarni ochish" Style="{StaticResource TextButton}" Clicked="OnDownloadsClicked" />
                    <Button Text="Qidirish" Style="{StaticResource TextButton}" Clicked="OnSearchClicked" />
                </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
