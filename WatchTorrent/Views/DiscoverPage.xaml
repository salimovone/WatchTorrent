<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:loc="clr-namespace:WatchTorrent.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:WatchTorrent.Controls"
    xmlns:vm="clr-namespace:WatchTorrent.ViewModels"
    x:Class="WatchTorrent.Views.DiscoverPage"
    Title="{loc:Translate S077}"
    Shell.NavBarIsVisible="false"
    x:DataType="vm:DiscoverViewModel">
    <Grid RowDefinitions="Auto,*" MaximumWidthRequest="1040">
        <VerticalStackLayout Padding="20,20,20,16" Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="WatchTorrent" Style="{StaticResource PageTitle}" VerticalOptions="Center" />
                <ImageButton
                    Grid.Column="1"
                    Source="tab_search.png"
                    BackgroundColor="Transparent"
                    WidthRequest="44"
                    HeightRequest="44"
                    Padding="10"
                    Clicked="OnSearchClicked"
                    SemanticProperties.Description="{loc:Translate S055}"
                    ToolTipProperties.Text="{loc:Translate S142}" />
            </Grid>
            <Grid ColumnDefinitions="*,132" ColumnSpacing="10">
                <controls:Dropdown Title="{loc:Translate S194}" AutomationId="CategoryDropdown"
                    ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />
                <controls:Dropdown Grid.Column="1" Title="{loc:Translate S033}" AutomationId="RangeDropdown"
                    IsVisible="{Binding ShowRanges}" ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange, Mode=TwoWay}" />
            </Grid>
        </VerticalStackLayout>
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView
                ItemsSource="{Binding Items}"
                ItemTemplate="{StaticResource TorrentRowTemplate}"
                SelectionMode="Single"
                SelectionChanged="OnTorrentSelected" />
        </RefreshView>
        <VerticalStackLayout
            Grid.Row="1"
            Padding="24,24"
            Spacing="12"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="Start"
            HorizontalOptions="Center">
            <ActivityIndicator IsRunning="{Binding IsBusy}" HeightRequest="28" />
            <Label Text="{loc:Translate S148}" Style="{StaticResource BodyText}" />
        </VerticalStackLayout>
        <ScrollView Grid.Row="1" IsVisible="{Binding HasError}">
            <VerticalStackLayout Padding="24,32" Spacing="12" MaximumWidthRequest="460">
                <Label Text="{loc:Translate S150}" Style="{StaticResource SectionTitle}" />
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource BodyText}" />
                <Button Text="{loc:Translate S140}" Command="{Binding RefreshCommand}" HorizontalOptions="Start" Margin="0,8,0,0" />
                <BoxView Style="{StaticResource Rule}" Margin="0,12" />
                <Label
                    Text="{loc:Translate S153}"
                    Style="{StaticResource BodyText}" />
                <FlexLayout Wrap="Wrap">
                    <Button Text="{loc:Translate S250}" Style="{StaticResource TextButton}" Clicked="OnDownloadsClicked" />
                    <Button Text="{loc:Translate S142}" Style="{StaticResource TextButton}" Clicked="OnSearchClicked" />
                </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
