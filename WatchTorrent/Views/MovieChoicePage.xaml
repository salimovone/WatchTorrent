<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:loc="clr-namespace:WatchTorrent.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WatchTorrent.Views.MovieChoicePage" BackgroundColor="{StaticResource Surface2}">
    <ScrollView>
        <Grid Padding="24" VerticalOptions="Center" MaximumWidthRequest="520">
            <Border Style="{StaticResource Card}" VerticalOptions="Center">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{loc:Translate S017}" TextColor="{StaticResource Accent}" FontFamily="OpenSansSemibold" />
                    <Grid ColumnDefinitions="Auto,*">
                        <Image x:Name="Poster" WidthRequest="86" HeightRequest="126" Margin="0,0,14,0"
                               Aspect="AspectFit" VerticalOptions="Start" IsVisible="False" />
                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label x:Name="MovieTitle" FontSize="21" FontFamily="OpenSansSemibold" MaxLines="3" LineBreakMode="TailTruncation" />
                            <Label x:Name="Tags" Style="{StaticResource Muted}" />
                            <Label x:Name="SizeAndFiles" FontFamily="OpenSansSemibold" />
                            <Label x:Name="Peers" Style="{StaticResource BodyText}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Label x:Name="SelectedFile" Style="{StaticResource Muted}" />
                    <Label x:Name="Details" Style="{StaticResource BodyText}" />
                    <ActivityIndicator x:Name="Waiting" Color="{StaticResource Accent}" />
                    <Button x:Name="Watch" Clicked="ChooseWatch" />
                    <Button x:Name="Download" Text="{loc:Translate S244}" Style="{StaticResource GhostButton}" Clicked="ChooseDownload" />
                    <Button x:Name="Cancel" Style="{StaticResource TextButton}" Clicked="ChooseCancel" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
