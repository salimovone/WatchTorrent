<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:loc="clr-namespace:WatchTorrent.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:WatchTorrent.ViewModels"
    xmlns:services="clr-namespace:WatchTorrent.Services"
    x:Class="WatchTorrent.Views.DownloadsPage"
    Title="{loc:Translate S247}"
    Shell.NavBarIsVisible="false"
    x:DataType="vm:DownloadsViewModel">
    <Grid RowDefinitions="Auto,*" MaximumWidthRequest="1040">
        <VerticalStackLayout Padding="20,20,20,16" Spacing="8">
            <Label Text="{loc:Translate S247}" Style="{StaticResource PageTitle}" />
            <Label Text="{Binding EngineStatus}" Style="{StaticResource Muted}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding PartnerDownloads}" Spacing="6">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:PartnerDownload">
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{Binding Percent, StringFormat='Sherigingizning yuklamasi · {0}%'}" TextColor="{StaticResource Accent}" />
                                <Label Text="{Binding Title}" MaxLines="2" LineBreakMode="TailTruncation" />
                                <ProgressBar Progress="{Binding Fraction}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Items}" SelectionMode="Single" SelectionChanged="OnDownloadSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="services:DownloadItem">
                    <Grid Padding="20,0,20,16">
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*,44" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                        <Label
                                            Text="{Binding Name}"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="15"
                                            MaxLines="2"
                                            LineBreakMode="TailTruncation" />
                                        <Label Text="{loc:Translate S012}" FontSize="12" TextColor="{StaticResource Accent}" />
                                    </VerticalStackLayout>
                                    <ImageButton
                                        Grid.Column="1"
                                        Source="ic_delete.png"
                                        BackgroundColor="Transparent"
                                        Padding="10"
                                        WidthRequest="44"
                                        HeightRequest="44"
                                        VerticalOptions="Start"
                                        Command="{Binding RemoveCommand, Source={RelativeSource AncestorType={x:Type vm:DownloadsViewModel}}}"
                                        CommandParameter="{Binding .}"
                                        IsEnabled="{Binding CanInteract}"
                                        SemanticProperties.Description="{loc:Translate S251}"
                                        ToolTipProperties.Text="{loc:Translate S114}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <Label Text="{Binding StatusText}" Style="{StaticResource Muted}" />
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding ProgressText}"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="13"
                                        TextColor="{StaticResource Accent}" />
                                </Grid>
                                <ProgressBar Progress="{Binding Progress}">
                                    <ProgressBar.Triggers>
                                        <DataTrigger TargetType="ProgressBar" Binding="{Binding IsComplete}" Value="True">
                                            <Setter Property="ProgressColor" Value="{StaticResource Seed}" />
                                        </DataTrigger>
                                    </ProgressBar.Triggers>
                                </ProgressBar>
                                <Label Text="{Binding SizeText}" Style="{StaticResource Muted}" />
                                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Start" />
                                <Label Text="{Binding TransferText}" Style="{StaticResource Muted}" IsVisible="{Binding IsRunning}" />
                                <FlexLayout Wrap="Wrap" JustifyContent="Start">
                                    <Button
                                        Text="{loc:Translate S195}"
                                        Margin="0,0,8,0"
                                        FontSize="13"
                                        Command="{Binding WatchCommand, Source={RelativeSource AncestorType={x:Type vm:DownloadsViewModel}}}"
                                        CommandParameter="{Binding .}" />
                                    <Button
                                        Text="{Binding ToggleText}"
                                        IsEnabled="{Binding CanInteract}"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource SmallButton}"
                                        IsVisible="{Binding CanToggle}"
                                        Command="{Binding ToggleCommand, Source={RelativeSource AncestorType={x:Type vm:DownloadsViewModel}}}"
                                        CommandParameter="{Binding .}" />
                                    <Button
                                        Text="{loc:Translate S051}"
                                        Style="{StaticResource SmallButton}"
                                        IsVisible="{Binding IsComplete}"
                                        Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:DownloadsViewModel}}}"
                                        CommandParameter="{Binding .}" />
                                </FlexLayout>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <VerticalStackLayout
            Grid.Row="1"
            Padding="20,24"
            Spacing="14"
            IsVisible="{Binding IsEmpty}"
            VerticalOptions="Start"
            MaximumWidthRequest="480">
            <Image
                Source="tab_downloads.png"
                WidthRequest="32"
                HeightRequest="32"
                Opacity="0.5"
                HorizontalOptions="Start"
                Margin="0,0,0,8" />
            <Label Text="{loc:Translate S018}" Style="{StaticResource SectionTitle}" />
            <Label
                Text="{loc:Translate S056}"
                Style="{StaticResource BodyText}" />
            <Button Text="{loc:Translate S053}" Style="{StaticResource GhostButton}" Clicked="OnSearchClicked" HorizontalOptions="Start" Margin="0,6,0,0" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
