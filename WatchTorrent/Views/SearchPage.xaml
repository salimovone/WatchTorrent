<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:loc="clr-namespace:WatchTorrent.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:WatchTorrent.Controls"
    xmlns:vm="clr-namespace:WatchTorrent.ViewModels"
    x:Class="WatchTorrent.Views.SearchPage"
    Title="{loc:Translate S143}"
    Shell.NavBarIsVisible="true"
    x:DataType="vm:SearchViewModel">
    <Grid RowDefinitions="Auto,Auto,*" MaximumWidthRequest="1040">
        <VerticalStackLayout Padding="20,16,20,16" Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border
                    Stroke="{StaticResource StrokeColor}"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{StaticResource Surface}">
                    <SearchBar
                        x:Name="SearchInput"
                        Text="{Binding Query}"
                        Placeholder="{loc:Translate S108}"
                        SearchButtonPressed="OnSearchPressed" />
                </Border>
                <Button Grid.Column="1" Text="{loc:Translate S142}" Clicked="OnSearchPressed" IsEnabled="{Binding HasQuery}" />
            </Grid>
        </VerticalStackLayout>
        <Grid
            Grid.Row="1"
            Padding="20,0,20,8"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="12"
            IsVisible="{Binding HasResults}">
            <Label Text="{Binding Summary}" Style="{StaticResource Muted}" VerticalOptions="Center" />
            <controls:Dropdown Grid.Column="1" WidthRequest="174"
                Title="{loc:Translate S154}" AutomationId="SortDropdown"
                ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort, Mode=TwoWay}" />
        </Grid>
        <CollectionView
            x:Name="ResultsList"
            Grid.Row="2"
            ItemsSource="{Binding Items}"
            ItemsUpdatingScrollMode="KeepScrollOffset"
            ItemTemplate="{StaticResource TorrentRowTemplate}"
            SelectionMode="Single"
            SelectionChanged="OnTorrentSelected"
            RemainingItemsThreshold="5"
            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
            <CollectionView.Footer>
                <VerticalStackLayout Padding="20,12,20,24" Spacing="8">
                    <ActivityIndicator IsRunning="{Binding IsLoadingMore}" IsVisible="{Binding IsLoadingMore}" HeightRequest="28" />
                    <Label Text="{Binding ErrorMessage}" Style="{StaticResource BodyText}" IsVisible="{Binding HasMoreError}" />
                    <Button
                        Text="{loc:Translate S235}"
                        Command="{Binding RetryCommand}"
                        Style="{StaticResource GhostButton}"
                        IsVisible="{Binding HasMoreError}" />
                </VerticalStackLayout>
            </CollectionView.Footer>
        </CollectionView>
        <VerticalStackLayout
            Grid.Row="2"
            Padding="24,36"
            Spacing="12"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="Start"
            HorizontalOptions="Center">
            <ActivityIndicator IsRunning="{Binding IsBusy}" HeightRequest="28" />
            <Label Text="{loc:Translate S141}" Style="{StaticResource BodyText}" />
        </VerticalStackLayout>
        <VerticalStackLayout
            Grid.Row="2"
            Padding="24,32"
            Spacing="10"
            IsVisible="{Binding ShowHint}"
            VerticalOptions="Start"
            MaximumWidthRequest="520">
            <Label Text="{loc:Translate S107}" Style="{StaticResource SectionTitle}" />
            <Label
                Text="{loc:Translate S057}"
                Style="{StaticResource BodyText}" />
            <BoxView Style="{StaticResource Rule}" Margin="0,14" />
            <Label
                Text="{loc:Translate S106}"
                Style="{StaticResource BodyText}" />
        </VerticalStackLayout>
        <VerticalStackLayout
            Grid.Row="2"
            Padding="24,32"
            Spacing="12"
            IsVisible="{Binding HasInitialError}"
            VerticalOptions="Start"
            MaximumWidthRequest="520">
            <Label Text="{loc:Translate S144}" Style="{StaticResource SectionTitle}" />
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource BodyText}" />
            <Button Text="{loc:Translate S139}" Command="{Binding RetryCommand}" HorizontalOptions="Start" />
        </VerticalStackLayout>
        <VerticalStackLayout
            Grid.Row="2"
            Padding="24,32"
            Spacing="10"
            IsVisible="{Binding IsEmpty}"
            VerticalOptions="Start"
            MaximumWidthRequest="520">
            <Label Text="{loc:Translate S104}" Style="{StaticResource SectionTitle}" />
            <Label
                Text="{loc:Translate S109}"
                Style="{StaticResource BodyText}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
