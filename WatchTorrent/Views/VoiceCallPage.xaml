<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="WatchTorrent.Views.VoiceCallPage" Title="Ulanish" Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="20,24" Spacing="16" MaximumWidthRequest="640">
            <Label Text="Ulanish" Style="{StaticResource PageTitle}" />
            <HorizontalStackLayout Spacing="10">
                <Ellipse x:Name="Indicator" WidthRequest="10" HeightRequest="10" VerticalOptions="Center" />
                <Label x:Name="ConnectionState" FontFamily="OpenSansSemibold" />
            </HorizontalStackLayout>
            <Label x:Name="StatusLabel" Style="{StaticResource BodyText}" />
            <Button x:Name="Offer" Text="Taklif yuborish" Clicked="CreateOffer" />
            <Button x:Name="Pick" Text="Havolani kiritish" Style="{StaticResource GhostButton}" Clicked="OpenLink" />
            <Button x:Name="Accept" Text="Taklifni qabul qilish" Clicked="AcceptOffer" />
            <Button x:Name="Mic" Clicked="ToggleMic" />
            <Button x:Name="Hangup" Text="Suhbatni tugatish" Style="{StaticResource GhostButton}" Clicked="EndCall" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
