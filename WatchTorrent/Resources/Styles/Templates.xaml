<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:WatchTorrent.ViewModels"
    xmlns:search="clr-namespace:TorrentReader.Search.Models;assembly=TorrentReader"
    xmlns:controls="clr-namespace:WatchTorrent.Controls"
    xmlns:converters="clr-namespace:WatchTorrent.Converters">
    <converters:HtmlDecodeConverter x:Key="HtmlDecode" />
    <converters:InvertBoolConverter x:Key="InvertBool" />
    <converters:TorrentLabelConverter x:Key="TorrentLabel" />
    <DataTemplate x:Key="TorrentRowTemplate" x:DataType="search:SearchResultItem">
        <Grid
            Padding="20,12,20,0"
            RowDefinitions="Auto,Auto"
            RowSpacing="12"
            ColumnDefinitions="64,*,16"
            ColumnSpacing="14">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Selected">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource Surface2}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border
                HeightRequest="92"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 4"
                BackgroundColor="{StaticResource Surface2}">
                <Grid>
                    <Image Source="ic_film.png" WidthRequest="24" HeightRequest="24" Opacity="0.3" />
                    <controls:PosterImage TorrentName="{Binding Name}" Aspect="AspectFill" />
                </Grid>
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="7" VerticalOptions="Center">
                <Label
                    Text="{Binding Name, Converter={StaticResource TorrentLabel}}"
                    ToolTipProperties.Text="{Binding Name, Converter={StaticResource HtmlDecode}}"
                    FontFamily="OpenSansSemibold"
                    FontSize="15"
                    MaxLines="2"
                    LineBreakMode="TailTruncation" />
                <Label
                    Text="{Binding Name, Converter={StaticResource TorrentLabel}, ConverterParameter=Release}"
                    FontSize="12"
                    TextColor="{StaticResource TextMuted}"
                    MaxLines="1"
                    LineBreakMode="TailTruncation" />
                <FlexLayout Wrap="Wrap" AlignItems="Center">
                    <Label Text="{Binding Size}" FontSize="12" TextColor="{StaticResource TextMuted}" Margin="0,0,14,0" />
                    <Label
                        Text="{Binding AmountSeeders, StringFormat='{0:N0} manba'}"
                        FontSize="12"
                        TextColor="{StaticResource Seed}" />
                </FlexLayout>
            </VerticalStackLayout>
            <Label Grid.Column="2" Text="›" FontSize="23" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
            <BoxView Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Rule}" />
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ChipTemplate" x:DataType="vm:ChipOption">
        <Border
            Padding="14,0"
            MinimumHeightRequest="44"
            Stroke="{StaticResource StrokeColor}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 6"
            BackgroundColor="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Selected">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource AccentSoft}" />
                            <Setter Property="Stroke" Value="{StaticResource Accent}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="13" VerticalOptions="Center" />
        </Border>
    </DataTemplate>
</ResourceDictionary>
