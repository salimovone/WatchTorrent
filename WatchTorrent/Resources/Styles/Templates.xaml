<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:WatchTorrent.Localization"
    xmlns:vm="clr-namespace:WatchTorrent.ViewModels"
    xmlns:controls="clr-namespace:WatchTorrent.Controls"
    xmlns:converters="clr-namespace:WatchTorrent.Converters">
    <converters:InvertBoolConverter x:Key="InvertBool" />
    <DataTemplate x:Key="TorrentRowTemplate" x:DataType="vm:TorrentRow">
        <Grid
            Padding="20,14,20,0"
            RowDefinitions="Auto,Auto"
            RowSpacing="14"
            ColumnDefinitions="64,*,16"
            ColumnSpacing="14">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Selected">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource Surface2}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border
                HeightRequest="92"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 8"
                BackgroundColor="{StaticResource Surface2}">
                <Grid>
                    <Image Source="ic_film.png" WidthRequest="24" HeightRequest="24" Opacity="0.3" />
                    <controls:PosterImage Title="{Binding PosterTitle}" WidthRequest="64" HeightRequest="92" Aspect="AspectFill" />
                </Grid>
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="7" VerticalOptions="Center">
                <Label
                    Text="{Binding Title}"
                    ToolTipProperties.Text="{Binding FullName}"
                    FontFamily="OpenSansSemibold"
                    FontSize="15"
                    MaxLines="2"
                    LineBreakMode="TailTruncation" />
                <Label
                    Text="{Binding Release}"
                    FontSize="12"
                    TextColor="{StaticResource TextMuted}"
                    MaxLines="1"
                    LineBreakMode="TailTruncation" />
                <Label FontSize="12" TextColor="{StaticResource TextMuted}" MaxLines="2" LineBreakMode="TailTruncation">
                    <Label.Text>
                        <MultiBinding StringFormat="{}{0}   ·   {1:N0} {2}">
                            <Binding Path="Item.Size" />
                            <Binding Path="Item.AmountSeeders" />
                            <loc:Translate Key="SeederUnit" />
                        </MultiBinding>
                    </Label.Text>
                </Label>
            </VerticalStackLayout>
            <Label Grid.Column="2" Text="›" FontSize="23" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
            <BoxView Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Rule}" />
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ChipTemplate" x:DataType="vm:ChipOption">
        <Border
            Padding="14,0"
            MinimumHeightRequest="44"
            Stroke="{StaticResource StrokeColor}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 6"
            BackgroundColor="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Selected">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource AccentSoft}" />
                            <Setter Property="Stroke" Value="{StaticResource Accent}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="13" VerticalOptions="Center" />
        </Border>
    </DataTemplate>
</ResourceDictionary>
